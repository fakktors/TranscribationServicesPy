# Copy to .env and adjust. Every variable is optional.

# --- Security -----------------------------------------------------------------
# Bearer token required for /v1 and /mcp (generate: openssl rand -hex 32).
# Leave empty only if the port is reachable from localhost alone.
TRANSCRIBE_API_TOKEN=

# Comma-separated hosts the service may download from ("*" = anything yt-dlp supports).
TRANSCRIBE_ALLOWED_HOSTS=youtube.com,youtu.be,youtube-nocookie.com

# --- Speaker diarization (optional) --------------------------------------------
# Hugging Face token with accepted terms for pyannote/speaker-diarization-3.1
# (https://huggingface.co/pyannote/speaker-diarization-3.1). Without it transcripts
# have no speaker labels.
HF_TOKEN=

# --- Speech recognition ----------------------------------------------------------
# Backend: auto | faster-whisper | mlx   (Docker always uses faster-whisper)
TRANSCRIBE_ASR_BACKEND=auto
# faster-whisper model: tiny | base | small | medium | large-v3 | large-v3-turbo | distil-large-v3 ...
# On CPU, large-v3-turbo is the best speed/quality trade-off; large-v3 is ~3-4x slower.
TRANSCRIBE_MODEL=large-v3-turbo
# auto | cpu | cuda
TRANSCRIBE_DEVICE=auto
# default (int8 on CPU, float16 on GPU) | int8 | int8_float16 | float16 | float32
TRANSCRIBE_COMPUTE_TYPE=default
# 0 = library default (all cores)
TRANSCRIBE_CPU_THREADS=0

# --- Download --------------------------------------------------------------------
# Max video length in seconds (requests can override with allow_long=true). 0 = no limit.
TRANSCRIBE_MAX_DURATION=3600
# Delete the 16 kHz WAV after the transcript is written (saves ~115 MB per hour of audio).
TRANSCRIBE_KEEP_AUDIO=false
# Netscape cookies.txt inside the container, for YouTube bot checks on datacenter IPs.
TRANSCRIBE_YTDLP_COOKIES=
# Extra yt-dlp arguments, e.g. --proxy socks5://host:1080
TRANSCRIBE_YTDLP_ARGS=

# --- Server ------------------------------------------------------------------------
# Upper bound for ?wait= / wait_seconds (seconds).
TRANSCRIBE_MAX_WAIT=600

# --- compose.yaml only -----------------------------------------------------------------
# Host interface/port to publish on. 0.0.0.0 exposes the service to the network.
BIND_ADDR=127.0.0.1
PORT=8000
# false = no pyannote/torch in the image (much smaller, no speaker labels)
WITH_DIARIZATION=true
